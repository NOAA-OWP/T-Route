# syntax=docker/dockerfile:1.4
# Debian (bookworm) + Python 3.12 dev/benchmark + prod images for t-route.
# Targets: dev (test/benchmark), troute (prod).
#   docker build --target dev    -f docker/Dockerfile.dev .
#   docker build --target troute -f docker/Dockerfile.dev .

### BASE IMAGE ###
# PYVER selects the CPython minor (default 3.12, the production target). Override
# for matched cross-version benchmarks, e.g. --build-arg PYVER=3.11.
ARG PYVER=3.12
FROM python:${PYVER}-slim-bookworm AS base

WORKDIR /t-route

ENV LANG="C.UTF-8" \
    CCACHE_DIR="/root/.cache/ccache" \
    CCACHE_MAXSIZE="5G" \
    # compiler.sh reads $NETCDF as the include dir; Debian puts netcdf.mod (from
    # libnetcdff-dev) and nc-config (netcdf-bin) under /usr/include // /usr/bin.
    NETCDF="/usr/include"

# System build deps in one cache-cleaned layer:
#  - gfortran/gcc/g++/make/cmake : the Fortran kernels + Cython/C extensions.
#  - libnetcdf-dev/libnetcdff-dev/netcdf-bin : the reservoir kernel links
#    -lnetcdff/-lnetcdf and reads `nc-config`.
#  - ccache : caches the Cython/C recompiles (no Fortran front end, so the
#    Fortran kernel just falls through). Wired via PATH symlinks rather than a
#    CC="ccache gcc" wrapper, since f2py/setup treat $F90 as a single path.
RUN set -eux && \
    apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ gfortran make cmake git ccache \
        libnetcdf-dev libnetcdff-dev netcdf-bin && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /usr/lib/ccache && \
    for c in gcc g++ cc gfortran; do ln -sf "$(command -v ccache)" "/usr/lib/ccache/$c"; done

# Virtual environment. /usr/lib/ccache is ahead of /usr/bin on PATH so the
# gcc/gfortran that compiler.sh + f2py invoke resolve to ccache.
ENV VIRTUAL_ENV=/opt/venv
RUN set -eux && python3 -m venv "$VIRTUAL_ENV"
ENV PATH="$VIRTUAL_ENV/bin:/usr/lib/ccache:$PATH"

# Non-t-route dependencies. matplotlib + psutil are the benchmark harness extras
# (charts + RSS/PSS sampler). The pip cache is a build mount (not an image
# layer), so the image stays small AND rebuilds skip re-downloading wheels.
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip,id=pip-cache \
    set -eux && \
    python -m pip install --upgrade pip && \
    python -m pip install -r requirements.txt && \
    python -m pip install matplotlib psutil

### DEV IMAGE ###
FROM base AS dev

# TROUTE_NATIVE controls host-specific arch flags (-mcpu=native / -march=native)
# on the MC Fortran kernel. Default 0 is a portable build; pass
# --build-arg TROUTE_NATIVE=1 for a host-tuned benchmark image.
ARG TROUTE_NATIVE=0
ENV TROUTE_NATIVE=${TROUTE_NATIVE}
COPY pyproject.toml compiler.sh ./
COPY src /t-route/src
RUN --mount=type=cache,target=/root/.cache/pip,id=pip-cache \
    --mount=type=cache,target=/root/.cache/ccache,id=ccache \
    set -eux && python -m pip install .[da,test,jupyter]
# ccache (via the PATH symlinks) caches the Cython/C compiles; the Fortran
# kernel is not cached (ccache has no Fortran front end). Drop the .o
# intermediates afterward (the editable install keeps the .so in src/).
RUN --mount=type=cache,target=/root/.cache/ccache,id=ccache \
    set -eux && ./compiler.sh && \
    find /t-route/src -name "*.o" -delete

EXPOSE 8000

LABEL org.opencontainers.image.source="https://github.com/NGWPC/t-route" \
      org.opencontainers.image.title="t-route" \
      org.opencontainers.image.description="t-route NWM channel routing (dev/benchmark image, Debian/py3.12)"

### PROD IMAGE ###
FROM base AS troute

COPY . .
# No [da] extra: it carried icechunk + zarr>=3 purely so the simple-scaling DA could
# read a bespoke observation store at runtime. That DA now reads the same TimeSlice
# files as every other observation consumer, so the base requirements cover it.
RUN --mount=type=cache,target=/root/.cache/ccache,id=ccache \
    set -eux && python -m pip install . && ./compiler.sh no-e && \
    find /t-route/src -name "*.o" -delete

RUN set -eux && mkdir -p /hydrofabric
RUN ulimit -n 10000

ENTRYPOINT ["/opt/venv/bin/python", "-m", "nwm_routing"]
